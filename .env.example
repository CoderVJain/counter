# Copy to .env and fill in. Never commit .env.
# Leave DATABASE_URL empty for local dev: domain/db.py falls back to sqlite:///counter.db.
# For Neon, copy the connection string from the Neon console, then make two edits:
#   1. scheme  postgresql://  ->  postgresql+psycopg://   (this project uses psycopg 3, not psycopg2)
#   2. append  ?sslmode=require                            (Neon refuses plaintext)
# Use the pooled host (the one containing "-pooler"). Result looks like:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxx-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
AWS_REGION=us-east-1
BEDROCK_MODEL_FAST=us.amazon.nova-micro-v1:0
BEDROCK_MODEL_SMART=us.amazon.nova-lite-v1:0
AGENTCORE_MEMORY_ID=
LLM_PROVIDER=bedrock
GROQ_API_KEY=
SUPPLIER_SIM_URL=http://localhost:8100
# Set when serving through a tunnel or Render, e.g. counter.onrender.com. Leave empty for localhost.
PUBLIC_HOST=
TELEGRAM_BOT_TOKEN=

# AWS credentials come from `aws configure` (~/.aws/credentials), not this file.
